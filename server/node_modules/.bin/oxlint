if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/mnt/d/lifeloom/server/node_modules/.pnpm/oxlint@1.88.0_oxlint-tsgolint@7.0.2004/node_modules/oxlint/bin/node_modules:/mnt/d/lifeloom/server/node_modules/.pnpm/oxlint@1.88.0_oxlint-tsgolint@7.0.2004/node_modules/oxlint/node_modules:/mnt/d/lifeloom/server/node_modules/.pnpm/oxlint@1.88.0_oxlint-tsgolint@7.0.2004/node_modules:/mnt/d/lifeloom/server/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/mnt/d/lifeloom/server/node_modules/.pnpm/oxlint@1.88.0_oxlint-tsgolint@7.0.2004/node_modules/oxlint/bin/node_modules:/mnt/d/lifeloom/server/node_modules/.pnpm/oxlint@1.88.0_oxlint-tsgolint@7.0.2004/node_modules/oxlint/node_modules:/mnt/d/lifeloom/server/node_modules/.pnpm/oxlint@1.88.0_oxlint-tsgolint@7.0.2004/node_modules:/mnt/d/lifeloom/server/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../.pnpm/oxlint@1.88.0_oxlint-tsgolint@7.0.2004/node_modules/oxlint/bin/oxlint" "$@"
else
  exec node  "$basedir/../.pnpm/oxlint@1.88.0_oxlint-tsgolint@7.0.2004/node_modules/oxlint/bin/oxlint" "$@"
fi
