APP_NAME=Lifeloom
APP_ENV=development
NODE_ENV=development
APP_VERSION=0.1.0
PORT=3000
HOST=0.0.0.0
API_PREFIX=api/v1
PUBLIC_API_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:19006,http://localhost:8081

GOOGLE_ALLOWED_AUDIENCES=replace-with-google-client-id
ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_SECRET=replace-with-another-32-random-characters
REFRESH_TOKEN_TTL=30d

MONGODB_URI=mongodb://lifeloom:lifeloom@localhost:27017/lifeloom?authSource=admin
MONGODB_DB_NAME=lifeloom
MONGODB_MAX_POOL_SIZE=20
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=replace-with-private-bucket
AWS_S3_PREFIX=development/
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
S3_ENDPOINT_URL=http://localhost:9000
S3_FORCE_PATH_STYLE=true
S3_PRESIGNED_URL_TTL_SECONDS=300
UPLOAD_TEMP_TTL_HOURS=24

EMAIL_ENABLED=false
EMAIL_DELIVERY_MODE=log
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Lifeloom
SMTP_FROM_EMAIL=
FUTURE_LETTER_EMAIL_FORMAT=secure_link

PUSH_NOTIFICATIONS_ENABLED=false
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

BACKGROUND_JOBS_ENABLED=false
SCHEDULER_POLL_INTERVAL_MS=5000
SCHEDULER_LEASE_SECONDS=60

RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100
REQUEST_BODY_LIMIT_MB=1
TRUST_PROXY=false
SHUTDOWN_TIMEOUT_MS=10000

APP_UPDATE_CHECK_ENABLED=true
ANDROID_PACKAGE_ID=
ANDROID_STORE_URL=
IOS_APP_STORE_ID=
IOS_STORE_URL=
